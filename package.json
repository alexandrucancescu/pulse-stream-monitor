{
  "name": "pulse-stream-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "description": "Standalone watchdog that listens to audio streams and records disconnects, stalls, and below-realtime flow.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "solid-js": "^1.9.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.1"
  }
}
